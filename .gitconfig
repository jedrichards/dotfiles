[alias]
	# Readable concise status
	s = status -s -b
	# Readble pretty logs
	l = log --pretty=format:'%Cred%h%Creset %s %Cgreen(%cr) %C(bold blue)<%ae>%Creset' --abbrev-commit --show-linear-break=~
	# Show the diff between the latest commit and the current state
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"

	# Hard reset current branch to the HEAD of its origin version
	# E.g. git rsc - resets the current branch to origin/{current_branch}
	rsc = !"git fetch origin -p && git reset --hard origin/$(git symbolic-ref --short -q HEAD)"

	# Switches to and hard resets the named branch to the HEAD of its origin version
	# E.g. git rs feat/foo - checks out feat/foo, and makes sure its up to date with origin/feat/foo
	rs = !"f() { git fetch origin -p && git checkout \"$1\" && git reset --hard origin/\"$1\"; }; f"

	# Rebase the current branch against the named origin branch
	# E.g. git rb main - rebases the current branch again origin/main
	rb = !"f() { git fetch origin -p && git rebase origin/\"$1\"; }; f"

	# Amend the previous commit with all currently staged and unstaged changes
	# The commit message of the last commit is preserved
	amend = !"git add -A && git commit --amend --no-edit"

	# Update submodules
	subs = !"git submodule sync --recursive && git submodule update --init --recursive"

	# Show verbose output about tags, branches or remotes
	tags = tag -l
	branches = branch -a
	remotes = remote -v

	# Bump a branch with an empty commit to restart stalled CI etc.
	bump = commit --allow-empty -m 'Empty commit'

	# Undo the last commit, it's changes become unstaged
	undo = reset HEAD~1

	# Push the current branch to origin
	# E.g. git pc - pushes the current branch to origin/{current_branch}
	pc = !"git push origin $(git symbolic-ref --short -q HEAD)"

	# Force push the current branch to origin
	# E.g. git pcf - force pushes the current branch to origin/{current_branch}
	pcf = !"git push origin $(git symbolic-ref --short -q HEAD) --force-with-lease"

	# Nuke all uncommited changes. Take care!
	nuke = !"git stash --include-untracked && git stash drop"

	# Make a new branch and switch to it
	# E.g. git nb feat/foo - creates a new branch feat/foo and switches to it
	nb = !"f() { git checkout -b \"$1\"; }; f"

	# Add everything and commit
	# E.g. git ca "My commit message" - adds all changes and commits them with the given message
	ca = !"f() { git add -A && git commit -m \"$1\"; }; f"

	# Automatically add worktree named after the passed branch, in a sibling folder to the main
	# checkout. If your branch is "feature/foo" and your main checkout folder is "repo-name", then
	# you'll get a worktree checked out at "../repo-name-worktrees/feature-foo"
	wta = !"f() { branch=\"${1//\\//-}\"; repo_name=$(basename \"$(git rev-parse --show-toplevel)\"); git worktree add \"$(git rev-parse --show-toplevel)/../${repo_name}-worktrees/$branch\" \"$1\"; }; f"
	wtl = worktree list
	wtr = worktree remove
[core]
	editor = nano
	trustctime = false
	untrackedCache = true
[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[merge]
	log = true
[push]
	default = simple
[diff]
	renames = copies
[include]
	path = ~/.gitconfig.personal
[http]
	postBuffer = 20000000
